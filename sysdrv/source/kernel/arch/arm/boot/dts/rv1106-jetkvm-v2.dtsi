#include "rv1106-amp.dtsi"

/ {
	chosen {
		bootargs = "earlycon=uart8250,mmio32,0xff4c0000 console=ttyFIQ0 rootwait snd_soc_core.prealloc_buffer_size_kbytes=16 coherent_pool=0";
	};

	/* HDMI-IN audio over I2S0 (capture only) */
	hdmi_sound: hdmi-sound {
		compatible = "simple-audio-card";
		simple-audio-card,name = "tc358743-hdmi";
		simple-audio-card,format = "i2s";

		/* TC358743 provides BCLK/LRCK (codec is master) */
		simple-audio-card,bitclock-master = <&dai_codec>;
		simple-audio-card,frame-master    = <&dai_codec>;
		/* Usually 256 * fs; harmless if unused */
		simple-audio-card,mclk-fs = <256>;

		simple-audio-card,cpu {
			sound-dai = <&i2s0_8ch>;
		};

		dai_codec: simple-audio-card,codec {
			/* Use the bridge's own DAI */
			sound-dai = <&tc358743>;
		};
	};

	vcc_1v8: vcc-1v8 {
		compatible = "regulator-fixed";
		regulator-name = "vcc_1v8";
		regulator-always-on;
		regulator-boot-on;
		regulator-min-microvolt = <1800000>;
		regulator-max-microvolt = <1800000>;
	};

	vcc_3v3: vcc-3v3 {
		compatible = "regulator-fixed";
		regulator-name = "vcc_3v3";
		regulator-always-on;
		regulator-boot-on;
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
	};

	vdd_arm: vdd-arm {
		compatible = "pwm-regulator";
		pwms = <&pwm0 0 5000 1>;
		regulator-name = "vdd_arm";
		regulator-min-microvolt = <724000>;
		regulator-max-microvolt = <1078000>;
		regulator-init-microvolt = <950000>;
		regulator-always-on;
		regulator-boot-on;
		regulator-settling-time-up-us = <250>;
	};

	hdmi_osc: hdmi-osc {
		compatible = "fixed-clock";
		clock-output-names = "hdmi-osc";
		clock-frequency = <27000000>;
		#clock-cells = <0>;
	};
};

&acodec {
	#sound-dai-cells = <0>;
	pa-ctl-gpios = <&gpio1 RK_PA1 GPIO_ACTIVE_HIGH>;
	status = "okay";
};

&cpu0 {
	cpu-supply = <&vdd_arm>;
};

&csi2_dphy_hw {
	status = "okay";
};

&csi2_dphy0 {
	status = "okay";

	ports {
		#address-cells = <1>;
		#size-cells = <0>;

		port@0 {
			reg = <0>;
			#address-cells = <1>;
			#size-cells = <0>;

			csi_dphy_input0: endpoint@0 {
				reg = <0>;
				remote-endpoint = <&hdmiin_out0>;
				/* DPHY uses lanes 1..2 on the SoC side */
				data-lanes = <1 2>;
			};
		};

		port@1 {
			reg = <1>;
			#address-cells = <1>;
			#size-cells = <0>;

			csi_dphy_output: endpoint@0 {
				reg = <0>;
				remote-endpoint = <&mipi_csi2_input>;
			};
		};
	};
};

&i2c4 {
	status = "okay";
	clock-frequency = <400000>;
	pinctrl-names = "default";
	pinctrl-0 = <&i2c4m2_xfer>;

	tc358743: tc358743@0f {
		compatible = "toshiba,tc358743";
		status = "okay";
		reg = <0x0f>;

		/* 27 MHz reference clock into the bridge */
		clocks = <&hdmi_osc>;
		clock-names = "refclk";

		reset-gpios = <&gpio3 RK_PC5 GPIO_ACTIVE_LOW>;

		rockchip,camera-module-index = <0>;
		rockchip,camera-module-facing = "back";
		rockchip,camera-module-name = "TC358743XBG";
		rockchip,camera-module-lens-name = "NC";

		/* Expose an ALSA DAI from the bridge */
		#sound-dai-cells = <0>;

		port {
			hdmiin_out0: endpoint {
				remote-endpoint = <&csi_dphy_input0>;
				data-lanes = <1 2 3 4>;
				clock-noncontinuous;
				link-frequencies = /bits/ 64 <297000000>;
			};
		};
	};
};

&i2s0_8ch {
	#sound-dai-cells = <0>;
	status = "okay";

	/* Use BCLK/LRCK from the bridge (RX clocks) */
	rockchip,clk-trcm = <1>;
	rockchip,trcm-sync-rx-only;

	pinctrl-names = "default";
	pinctrl-0 = <&i2s0m0_sclk_rx &i2s0m0_lrck_rx &i2s0m0_sdi0>;

	/* Keep an internal rate for math; do not drive MCLK out */
	assigned-clocks = <&cru SCLK_I2S0_8CH>;
	assigned-clock-parents = <&cru PLL_GPLL>;
	assigned-clock-rates = <12288000>;
};

&mipi0_csi2 {
	status = "okay";

	ports {
		#address-cells = <1>;
		#size-cells = <0>;

		port@0 {
			reg = <0>;
			#address-cells = <1>;
			#size-cells = <0>;

			mipi_csi2_input: endpoint@1 {
				reg = <1>;
				remote-endpoint = <&csi_dphy_output>;
			};
		};

		port@1 {
			reg = <1>;
			#address-cells = <1>;
			#size-cells = <0>;

			mipi_csi2_output: endpoint@0 {
				reg = <0>;
				remote-endpoint = <&cif_mipi_in>;
			};
		};
	};
};

&rkcif {
	status = "okay";
};

&rkcif_mipi_lvds {
	status = "okay";

	pinctrl-names = "default";
	pinctrl-0 = <&mipi_pins>;
	port {
		cif_mipi_in: endpoint {
			remote-endpoint = <&mipi_csi2_output>;
		};
	};
};

&saradc {
	status = "okay";
	vref-supply = <&vcc_1v8>;
};

&tsadc {
	status = "okay";
};

&crypto {
	status = "okay";
};

/* Extra I2S0 RX pin labels so the phandles resolve */
&pinctrl {
	i2s0_fix: i2s0-fix {
		/omit-if-no-ref/
		i2s0m0_sclk_rx: i2s0m0-sclk-rx {
			rockchip,pins = <2 RK_PA0 2 &pcfg_pull_none>;
		};
		/omit-if-no-ref/
		i2s0m0_lrck_rx: i2s0m0-lrck-rx {
			rockchip,pins = <2 RK_PA1 2 &pcfg_pull_none>;
		};
		/omit-if-no-ref/
		i2s0m0_sdi0: i2s0m0-sdi0 {
			rockchip,pins = <2 RK_PA5 2 &pcfg_pull_none>;
		};
		/omit-if-no-ref/
		i2s0m0_mclk: i2s0m0-mclk {
			rockchip,pins = <2 RK_PA2 2 &pcfg_pull_none>;
		};
	};
};
